@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>NextStop - Landing</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        /* Page (full viewport, no scroll) */
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            overflow: hidden;
            background-image: url('/images/Background.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        /* Centered rounded backdrop panel */
        .hero-panel {
            box-sizing: border-box;
            width: calc(100% - 120px);
            max-width: 1200px;
            height: calc(100% - 120px);
            margin: 60px auto;
            border-radius: 20px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-image: url('/images/Backdrop.png');
            background-size: cover;
            background-position: center;
            box-shadow: 0 6px 30px rgba(0,0,0,0.35);
        }

        /* content columns */
        .left-col {
            flex: 0 0 45%;
            padding: 56px 48px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
        }

        /* align download button and qr together */
        .qr-section {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            margin-top: 24px;
        }

        .right-col {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 28px;
        }

        /* Logo */
        .ns-logo {
            width: 120px;
            height: auto;
            object-fit: contain;
        }

        /* Headings & text */
        .brand-title {
            margin-top: 6px;
            font-size: 44px;
            line-height: 1;
            color: #00A4A4;
            font-weight: 700;
        }

            .brand-title .accent {
                color: #F58220;
            }

        .tagline {
            margin-top: 8px;
            color: #333;
            font-size: 16px;
            font-weight: 500;
        }

        /* QR block */
        .qr-wrap {
            width: 220px;
            height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.95);
            border-radius: 6px;
            padding: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

            .qr-wrap img {
                max-width: 100%;
                max-height: 100%;
                display: block;
            }

        .small-note {
            font-size: 12px;
            color: rgba(0,0,0,0.6);
            margin-top: 12px;
            max-width: 320px;
            font-weight:bold;
        }

        /* Download button */
        .dl-btn {
            background: #f58220;
            color: white;
            border-radius: 30px;
            padding: 12px 28px;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 6px 18px rgba(245,130,32,0.18);
            transition: background 0.2s ease;
        }

            .dl-btn:hover {
                background: #e46e0d;
            }

        /* Right product image container */
        .product-image {
            max-width: 620px;
            width: 100%;
            height: auto;
            object-fit: contain;
            transform: translateX(8px);
        }

        /* Responsive rules */
        @@media (max-width: 900px) {
            .hero-panel

        {
            flex-direction: column;
            width: calc(100% - 40px);
            height: auto;
            margin: 20px auto;
            padding: 20px;
            border-radius: 16px;
        }

        .left-col {
            align-items: center;
            text-align: center;
            padding: 18px;
        }

        .qr-section {
            align-items: center;
        }

        .right-col {
            padding: 12px;
        }

        .ns-logo {
            width: 90px;
        }

        .brand-title {
            font-size: 34px;
        }

        .qr-wrap {
            width: 200px;
            height: 200px;
        }

        .product-image {
            max-width: 420px;
            margin-top: 18px;
        }

        }

        @@media (max-width: 420px) {
            .brand-title

        {
            font-size: 28px;
        }

        .qr-wrap {
            width: 170px;
            height: 170px;
        }

        .dl-btn {
            padding: 10px 22px;
            font-size: 15px;
        }

        }
    </style>
</head>
<body>
    <main class="h-100 d-flex align-items-center justify-content-center">
        <section class="hero-panel" role="region" aria-label="NextStop download panel">

            <!-- LEFT column (logo, heading, tagline, QR, note, button) -->
            <div class="left-col">
                <img src="/images/NS_logo.png" alt="NS_logo" class="ns-logo" />

                <h1 class="brand-title">
                    <span>Next</span><span class="accent">Stop</span>
                </h1>

                <div class="tagline">Your smart companion for BGC Bus commuting.</div>

                <div class="qr-section">
                    <div class="qr-wrap">
                        <img src="/images/POSTSURVEY.png" alt="POSTSURVEY" />
                    </div>
                    <div class="small-note">
                        Please let us hear your feedback after using our app. Thank you.
                    </div>
                    <a class="dl-btn" href="@Url.Action("DownloadApk", "Home")" role="button" aria-label="Download NextStop">
                        Download APK
                    </a>
                </div>
            </div>


            <!-- RIGHT column (product image) -->
            <div class="right-col">
                <img src="/images/ProductImage.png" alt="ProductImage" class="product-image" />
            </div>
        </section>
    </main>

    <!-- Bootstrap JS (kept for Bootstrap layout support) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
