@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>NextStop - Landing</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        /* Page (full viewport, no scroll) */
        html, body {
          height: 100%;
          margin: 0;
        }
        body {
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
          overflow: hidden; /* no scrolling, page fits viewport */
          background-image: url('/images/Background.png'); /* change path if needed */
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
        }

        /* Centered rounded backdrop panel */
        .hero-panel {
          box-sizing: border-box;
          width: calc(100% - 120px);
          max-width: 1200px;
          height: calc(100% - 120px);
          margin: 60px auto;
          border-radius: 20px;
          overflow: hidden;
          display: flex;
          align-items: stretch;
          background-image: url('/images/Backdrop.png'); /* semitransparent rectangle graphic */
          background-size: cover;
          background-position: center;
          box-shadow: 0 6px 30px rgba(0,0,0,0.35);
        }

        /* content columns */
        .left-col {
          flex: 0 0 44%;
          padding: 56px 48px;
          display: flex;
          flex-direction: column;
          gap: 20px;
          justify-content: center;
        }

        .right-col {
          flex: 1 1 auto;
          padding: 28px;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        /* Logo */
        .ns-logo {
          width: 120px;
          height: auto;
          object-fit: contain;
        }

        /* Headings & text */
        .brand-title {
          margin: 6px 0 0 0;
          font-size: 44px;
          line-height: 1;
          color: #00A4A4; /* teal-ish for "Next" */
          font-weight: 700;
        }
        /* second color for the orange segment */
        .brand-title .accent {
          color: #F58220;
        }

        .tagline {
          margin-top: 6px;
          color: #333;
          font-size: 16px;
          font-weight: 500;
        }

        /* QR block */
        .qr-wrap {
          width: 220px;
          height: 220px;
          display: flex;
          align-items: center;
          justify-content: center;
          background: rgba(255,255,255,0.95);
          border-radius: 6px;
          padding: 12px;
          box-shadow: 0 4px 10px rgba(0,0,0,0.08);
          margin-top: 18px;
        }
        .qr-wrap img {
          max-width: 100%;
          max-height: 100%;
          display: block;
        }

        .small-note {
          font-size: 12px;
          color: rgba(0,0,0,0.6);
          margin-top: 12px;
          max-width: 320px;
        }

        /* Download button (orange pill) */
        .dl-btn {
          display: inline-block;
          margin-top: 18px;
          background: #f58220;
          color: white;
          border-radius: 30px;
          padding: 12px 28px;
          font-weight: 600;
          text-decoration: none;
          box-shadow: 0 6px 18px rgba(245,130,32,0.18);
        }

        /* Right product image container */
        .product-image {
          max-width: 680px;
          width: 100%;
          height: auto;
          display: block;
          object-fit: contain;
          transform: translateX(8px);
        }

        /* Responsive rules - mobile stack in requested order */
        @media (max-width: 900px) {
          .hero-panel {
            flex-direction: column;
            width: calc(100% - 40px);
            height: calc(100% - 40px);
            margin: 20px auto;
            border-radius: 16px;
            padding: 16px 12px;
          }
          .left-col {
            order: 1;
            width: 100%;
            flex: 0 0 auto;
            padding: 18px;
            align-items: center;
            text-align: center;
          }
          .right-col {
            order: 2;
            padding: 12px;
          }

          .ns-logo { width: 90px; }

          .brand-title { font-size: 34px; }

          .qr-wrap { width: 200px; height: 200px; margin: 12px 0; }

          .left-col .tagline,
          .left-col .small-note { max-width: 100%; }

          /* product image placed after download button (per requested mobile order) */
          .product-image { max-width: 420px; margin-top: 18px; }
        }

        @media (max-width: 420px) {
          .brand-title { font-size: 28px; }
          .qr-wrap { width: 170px; height: 170px; }
          .dl-btn { padding: 10px 22px; font-size: 15px; }
        }

        /* Accessibility / focus */
        .dl-btn:focus, .dl-btn:hover { text-decoration: none; }

    </style>
</head>
<body>
    <main class="h-100 d-flex align-items-center justify-content-center">
        <section class="hero-panel" role="region" aria-label="NextStop download panel">

            <!-- LEFT column (logo, heading, tagline, QR, note, button) -->
            <div class="left-col">
                <img src="/images/NS_logo.png" alt="NS_logo" class="ns-logo" />

                <h1 class="brand-title">
                    <span>Next</span><span class="accent">Stop</span>
                </h1>

                <div class="tagline">Your smart companion for BGC Bus commuting.</div>

                <div class="qr-wrap" aria-hidden="false">
                    <img src="/images/POSTSURVEY.png" alt="POSTSURVEY" />
                </div>

                <div class="small-note">
                    Please let us hear your feedback after using our app. Thank you.
                </div>

                <a class="dl-btn" href="#" role="button" aria-label="Download NextStop">
                    <!-- INSERT DOWNLOAD LINK HERE -> href="/your/link" -->
                    Download
                </a>
            </div>

            <!-- RIGHT column (product image) -->
            <div class="right-col">
                <img src="/images/ProductImage.png" alt="ProductImage" class="product-image" />
            </div>
        </section>
    </main>

    <!-- Bootstrap JS (kept for Bootstrap layout support) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
