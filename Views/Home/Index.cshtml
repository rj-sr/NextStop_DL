@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>NextStop - Landing</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            overflow: hidden;
        }

        body {
            background-image: url("/images/Background.png");
            background-size: cover;
            background-position: center;
        }

        .hero-panel {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            width: calc(100% - 120px);
            max-width: 1400px;
            height: calc(100% - 120px);
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 8px 45px rgba(0,0,0,0.35);
        }

        .backdrop {
            position: absolute;
            inset: 0;
            background-image: url("/images/Backdrop.png");
            background-size: cover;
            background-position: center;
            opacity: 0.9;
        }

        .content {
            position: relative;
            z-index: 3;
            height: 100%;
            width: 100%;
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            padding: 0 40px;
            gap: 0;
        }

        /* LEFT COLUMN */
        .left-col {
            flex: 0 0 42%;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
        }

        .ns-logo {
            width: 350px;
            height: auto;
            object-fit: contain;
        }

        .tagline {
            color: #3c3c3c;
            font-size: 17px;
            font-weight: 600;
        }

        .dl-btn {
            background: #FA7003;
            color: #fff;
            border-radius: 30px;
            padding: 14px 40px;
            font-weight: 700;
            font-size: 18px;
            text-decoration: none;
            margin-top: 18px;
            box-shadow: 0 8px 25px rgba(245,130,32,0.25);
        }

            .dl-btn:hover {
                opacity: 0.9;
            }

        /* RIGHT COLUMN */
        .right-col {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: flex-end;
        }

        .product-image {
            width: 120%;
            max-width: 1100px;
            object-fit: contain;
        }

        /* MOBILE RESPONSIVE */
        @@media (max-width: 1000px) {
            .hero-panel

        {
            width: calc(100% - 30px);
            height: calc(100% - 30px);
        }

        .content {
            flex-direction: column;
            padding: 20px;
            gap: 20px;
            justify-content: flex-start;
        }

        .left-col {
            order: 1;
            width: 100%;
        }

        .right-col {
            order: 2;
            width: 100%;
            justify-content: center;
        }

        .product-image {
            width: 360px;
        }

        }

        @@media (max-width: 420px) {
            .ns-logo

        {
            width: 140px;
        }

        .product-image {
            width: 260px;
        }

        .dl-btn {
            font-size: 16px;
            padding: 12px 26px;
        }

        }
    </style>
</head>

<body>
    <main style="height:100vh; width:100vw; display:flex; align-items:center; justify-content:center;">
        <section class="hero-panel">
            <div class="backdrop"></div>

            <div class="content">

                <!-- LEFT -->
                <div class="left-col">
                    <img src="/images/NS_logo.png"
                         alt="BGC Bus NextStop logo"
                         class="ns-logo" />

                    <p class="tagline">Your smart companion for BGC Bus commuting.</p>

                    <a class="dl-btn" href="@Url.Action("DownloadApk", "Home")" role="button" aria-label="Download NextStop">
                        Download APK
                    </a>
                </div>

                <!-- RIGHT -->
                <div class="right-col">
                    <img src="/images/ProductImage.png"
                         alt="BGC Bus App UI Preview"
                         class="product-image" />
                </div>
            </div>
        </section>
    </main>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

