<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>NextStop</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            background: url("C:/Users/Iana/Documents/NOTEPAD++/0NEXTSTOP_ASP/WEBSITE/Background.png") no-repeat center center fixed;
            background-size: cover;
            height: 100vh;
            overflow: hidden;
        }

        .backdrop {
            background: rgba(255, 255, 255, 0.1);
            background-image: url("C:/Users/Iana/Documents/NOTEPAD++/0NEXTSTOP_ASP/WEBSITE/Backdrop.png");
            background-size: cover;
            background-repeat: no-repeat;
            border-radius: 20px;
            width: 85%;
            height: 85%;
            margin: auto;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 50px 70px;
        }

        .left-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #2D3839;
            transform: translateX(-80px);
        }

        .logo {
            width: 180px;
            margin-bottom: 20px;
        }

        .nextstop-title {
            font-size: 2.4rem;
            font-weight: 700;
        }

            .nextstop-title span:first-child {
                color: #04979F;
            }

            .nextstop-title span:last-child {
                color: #FA7003;
            }

        .subtitle {
            margin-top: 10px;
            font-weight: 600;
            color: #2D3839;
        }

        .qr {
            width: 180px;
            margin: 30px 0;
        }

        .feedback {
            color: #C5F9FF;
            font-weight: 500;
            font-size: 0.95rem;
        }

        .download-btn {
            margin-top: 15px;
            background: url("C:/Users/Iana/Documents/NOTEPAD++/0NEXTSTOP_ASP/WEBSITE/dlbutton.png") no-repeat center;
            background-size: contain;
            width: 180px;
            height: 50px;
            border: none;
            cursor: pointer;
        }

        .right-section {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            transform: translateX(-70px);
        }

        .product-image {
            width: 140%;
            max-width: 1140px;
            transform: scale(1.20);
        }

        (max-width: 768px) {
            .backdrop

        {
            flex-direction: column;
            height: 100%;
            width: 100%;
            border-radius: 0;
            padding: 30px 20px;
            overflow-y: auto;
        }

        .left-section {
            align-items: center;
            text-align: center;
            transform: none;
        }

        .right-section {
            margin-top: 20px;
            transform: none;
        }

        .product-image {
            width: 100%;
            max-width: 420px;
            transform: none;
        }

        }
    </style>
</head>
<body>
    <div class="backdrop">
        <div class="left-section">
            <img src="C:/Users/Iana/Documents/NOTEPAD++/0NEXTSTOP_ASP/WEBSITE/NS_logo.png" alt="Logo" class="logo">
            <div class="nextstop-title">
                <span>Next</span><span>Stop</span>
            </div>
            <div class="subtitle">Your smart companion for BGC Bus commuting.</div>
            <img src="C:/Users/Iana/Documents/NOTEPAD++/0NEXTSTOP_ASP/WEBSITE/POSTSURVEY.png" alt="QR" class="qr">
            <div class="feedback">Please let us hear your feedback after using our app.<br>Thank you.</div>
            
            <!-- Download Link for # -->
            <button class="download-btn" onclick="window.location.href='#';"></button>
        </div>

        <div class="right-section">
            <img src="C:/Users/Iana/Documents/NOTEPAD++/0NEXTSTOP_ASP/WEBSITE/ProductImage.png" alt="Product Image" class="product-image">
        </div>
    </div>
</body>
</html>
